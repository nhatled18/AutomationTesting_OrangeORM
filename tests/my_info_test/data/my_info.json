[
    {
        "scenario": "Happy Path: Cập nhật thông tin hợp lệ",
        "data": {
            "firstName": "Manda",
            "lastName": "User",
            "otherId": "999999",
            "nationality": "Vietnamese",
            "maritalStatus": "Married",
            "gender": "Male"
        },
        "expected": "success"
    },
    {
        "scenario": "Negative: Để trống First Name",
        "data": {
            "firstName": ""
        },
        "expected": "error_firstName_required"
    },
    {
        "scenario": "Negative: Để trống Last Name",
        "data": {
            "lastName": ""
        },
        "expected": "error_lastName_required"
    },
    {
        "scenario": "Negative: Nhập tên quá dài (Boundary Test)",
        "data": {
            "firstName": "NguyenVanANguyenVanANguyenVanANguyenVanANguyenVanA"
        },
        "expected": "warning_length"
    },
    {
        "scenario": "Negative: Nhập ký tự đặc biệt vào tên",
        "data": {
            "firstName": "Nguyen@123!",
            "lastName": "Van#456"
        },
        "expected": "success_or_warning"
    },
    {
        "scenario": "Negative: Nhập sai định dạng ngày tháng (nếu input tay)",
        "data": {
            "dob": "99-99-9999"
        },
        "expected": "error_date_format"
    }
]
